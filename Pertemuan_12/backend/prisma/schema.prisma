// Skema pertemuan 12: pembayaran dan webhook.
// Jalankan:  npx prisma migrate dev --name tambah-pembayaran

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Kategori {
  id     Int      @id @default(autoincrement())
  nama   String   @unique
  slug   String   @unique
  produk Produk[]
}

model Produk {
  id         Int           @id @default(autoincrement())
  nama       String
  harga      Int
  stok       Int           @default(0)
  deskripsi  String?
  gambar     String?
  kategoriId Int
  kategori   Kategori      @relation(fields: [kategoriId], references: [id])
  item       ItemPesanan[]
  dibuatPada DateTime      @default(now())
  diubahPada DateTime      @updatedAt

  @@index([kategoriId])
  @@index([nama])
}

model Pengguna {
  id           Int       @id @default(autoincrement())
  nama         String
  email        String    @unique
  passwordHash String?
  peran        String    @default("user")
  pesanan      Pesanan[]
}

model Pesanan {
  id          Int           @id @default(autoincrement())
  penggunaId  Int
  pengguna    Pengguna      @relation(fields: [penggunaId], references: [id])
  // menunggu_pembayaran | dibayar | dikirim | selesai | kedaluwarsa | gagal
  status      String        @default("menunggu_pembayaran")
  total       Int
  item        ItemPesanan[]
  dibuatPada  DateTime      @default(now())

  // --- Pembayaran ---
  pembayaranId String?       @unique // ID charge di gateway (mis. "ch_ab12...")
  paymentUrl   String?
  dibayarPada  DateTime?
  catatan      String?       // untuk rekonsiliasi manual (anomali)

  @@index([penggunaId])
  @@index([status])
}

model ItemPesanan {
  id          Int     @id @default(autoincrement())
  pesananId   Int
  produkId    Int
  jumlah      Int
  hargaSatuan Int
  pesanan     Pesanan @relation(fields: [pesananId], references: [id], onDelete: Cascade)
  produk      Produk  @relation(fields: [produkId], references: [id])

  @@unique([pesananId, produkId])
  @@index([produkId])
}

// Daftar ID peristiwa webhook yang SUDAH diproses -> dedupe (UNIQUE pada primary key)
model EventWebhook {
  id          String   @id
  jenis       String
  diterimaPada DateTime @default(now())
}
