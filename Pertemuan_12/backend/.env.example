PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL="file:./dev.db"
LOG_QUERY=0

# ---- Autentikasi ----
# WAJIB diisi, minimal 32 karakter acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=15m
BCRYPT_COST=12
LOGIN_MAX=10

# ---- Unggahan ----
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# ---- Payment gateway ----
# Nilai HARUS sama dengan pada mock-gateway/.env. Rahasia berbeda untuk tiap lingkungan!
GATEWAY_BASE_URL=http://localhost:4100
GATEWAY_API_KEY=sk_test_praktikum_12345
GATEWAY_WEBHOOK_SECRET=whsec_praktikum_67890abcdef
# Batas waktu panggilan ke gateway (ms)
GATEWAY_TIMEOUT_MS=5000
