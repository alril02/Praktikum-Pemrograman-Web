# ===== Contoh variabel lingkungan =====
# LOKAL: salin ke .env.   PRODUKSI: isi lewat panel PaaS / secret manager (JANGAN commit nilai nyata).

NODE_ENV=development
PORT=3000

# Jumlah hop reverse proxy yang dipercaya (0 = langsung ke internet; 1 = satu proxy seperti Nginx/PaaS)
TRUST_PROXY=0

# Asal frontend yang diizinkan (pisahkan koma). Produksi: HANYA https://<domain-frontend>
CORS_ORIGINS=http://localhost:5173

# SQLite untuk lokal. Produksi: PostgreSQL terkelola, mis.
#   postgresql://user:password@host:5432/toko?schema=public
DATABASE_URL="file:./dev.db"

# ---- Autentikasi ----
# >= 32 karakter acak:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=15m
BCRYPT_COST=12
LOGIN_MAX=10

# ---- Unggahan ----
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# ---- Payment gateway ----
GATEWAY_BASE_URL=http://localhost:4100
GATEWAY_API_KEY=sk_test_praktikum_12345
GATEWAY_WEBHOOK_SECRET=whsec_praktikum_67890abcdef
GATEWAY_TIMEOUT_MS=5000

# ---- Antrean & cache ----
JOB_MAX_PERCOBAAN=5
JOB_BACKOFF_MS=1000
JOB_POLL_MS=500
JOB_LOCK_TIMEOUT_MS=60000
EMAIL_DELAY_MS=1500
CACHE_TTL_MS=30000
CACHE_MAX_ENTRIES=500
