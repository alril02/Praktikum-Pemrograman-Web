PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL="file:./dev.db"
LOG_QUERY=0

# ---- Autentikasi ----
# WAJIB diisi, minimal 32 karakter acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=15m
BCRYPT_COST=12
LOGIN_MAX=10

# ---- Unggahan ----
# Folder penyimpanan berkas (relatif terhadap folder proyek). Di produksi: LUAR web root aplikasi.
UPLOAD_DIR=uploads
# Batas ukuran unggahan dalam byte (2 MB)
MAX_UPLOAD_BYTES=2097152
