PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL="file:./dev.db"
LOG_QUERY=0

# ---- Autentikasi ----
# WAJIB diisi, minimal 32 karakter acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=15m
BCRYPT_COST=12
LOGIN_MAX=20

# ---- Unggahan ----
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# ---- Payment gateway (harus sama dengan mock-gateway/.env) ----
GATEWAY_BASE_URL=http://localhost:4100
GATEWAY_API_KEY=sk_test_praktikum_12345
GATEWAY_WEBHOOK_SECRET=whsec_praktikum_67890abcdef
GATEWAY_TIMEOUT_MS=5000

# ---- Antrean job (nilai lab: cepat agar mudah diamati; produksi: lebih longgar) ----
JOB_MAX_PERCOBAAN=4
JOB_BACKOFF_MS=300
JOB_POLL_MS=200
JOB_LOCK_TIMEOUT_MS=60000
# Simulasi layanan email yang LAMBAT (ms)
EMAIL_DELAY_MS=1200

# ---- Cache ----
CACHE_TTL_MS=30000
CACHE_MAX_ENTRIES=500
