{
  "name": "toko-api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "worker": "node src/queue/worker-main.js",
    "lint": "node scripts/lint-sintaks.mjs",
    "cek-env": "node --env-file-if-exists=.env scripts/cek-env.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "ajv": "^8.17.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
