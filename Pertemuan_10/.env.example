PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL="file:./dev.db"
LOG_QUERY=0

# ---- Autentikasi ----
# WAJIB diganti. Minimal 32 karakter acak. Hasilkan dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=15m

# Biaya bcrypt (12 disarankan; turunkan hanya untuk pengembangan lokal yang lambat)
BCRYPT_COST=12

# Batas percobaan login per IP per menit
LOGIN_MAX=10
